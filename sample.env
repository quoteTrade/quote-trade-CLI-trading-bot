API_BASE_URL=https://app.quote.trade/api
LIQUIDITY_WS_URL=wss://app.quote.trade/ws/liquidity
LISTEN_KEY_WS_URL=wss://app.quote.trade/ws/listenKey
MODE=paper
TRADE_API_KEY=
TRADE_API_SECRET=
SIGNING_ALGORITHM=sha256
QUOTE_TRADE_STATE_DIR=.quote-trade
POSITIONS_ENDPOINT=/positions
# Optional LLM strategy planner keys. Prefer env vars over storing raw keys in .quote-trade/llm-config.json.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OVHCLOUD_API_KEY=
AI_ENDPOINT_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
HF_TOKEN=
POLLINATIONS_API_KEY=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
# Optional Codex OAuth planner. codex:connect uses the local Codex CLI and a per-owner CODEX_HOME under QUOTE_TRADE_STATE_DIR.
CODEX_BIN=codex
CODEX_MODEL=default
CODEX_EXEC_TIMEOUT_MS=120000
QUOTE_TRADE_LLM_OWNER=default
